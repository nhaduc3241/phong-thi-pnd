# Chép file này thành .env rồi điền thông tin. KHÔNG commit file .env.

# Địa chỉ web WooCommerce
WOO_URL=https://mohinhdeerstore.com
# Tạo ở: WooCommerce > Cài đặt > Nâng cao > REST API > Thêm khoá (quyền Đọc/Ghi)
WOO_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Đặt 1 nếu bị lỗi 401 (hosting chia sẻ đôi khi bỏ header Authorization)
WOO_AUTH_IN_QUERY=0

# Trạng thái của đơn mới cần tìm mã vận đơn, cách nhau bằng dấu phẩy
WOO_STATUSES=processing
# Chỉ lấy các đơn trên tạo trong N ngày gần nhất (0 = không giới hạn).
# Đơn ở SHIPPING_STATUS luôn được theo dõi tới khi giao xong, không giới hạn ngày.
MAX_AGE_DAYS=5
# Meta key chứa mã SPX (nếu dùng plugin hoặc trường tuỳ chỉnh). Để trống thì dùng mặc định
# và tự quét cả ghi chú đơn để tìm chuỗi dạng SPXVN...
#WOO_TRACKING_META_KEYS=_spx_tracking

# Mã tham chiếu điền khi tạo đơn SPX = tiền tố + số đơn. Ví dụ DEERSTORE4212 cho đơn #4212.
# Để trống thì chỉ theo dõi các đơn đã có sẵn mã SPXVN.
ORDER_REF_PREFIX=DEERSTORE
# Meta key để lưu mã SPXVN tìm được vào đơn
TRACKING_META_KEY=spx_tracking

# Slug trạng thái (xem bằng: python sync_woo.py --inspect <số đơn>). Để trống = không đổi trạng thái.
# Khi tìm thấy mã vận đơn -> chuyển sang trạng thái này:
SHIPPING_STATUS=
# Khi SPX báo đã giao -> chuyển sang trạng thái này (mặc định WooCommerce: completed):
DELIVERED_STATUS=
# 1 = ghi chú nội bộ (khách không thấy, không gửi email cho khách)
PRIVATE_NOTES=0
