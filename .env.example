# Chép file này thành .env rồi điền thông tin. KHÔNG commit file .env.

# Địa chỉ web WooCommerce
WOO_URL=https://mohinhdeerstore.com
# Tạo ở: WooCommerce > Cài đặt > Nâng cao > REST API > Thêm khoá (quyền Đọc/Ghi)
WOO_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Đặt 1 nếu bị lỗi 401 (hosting chia sẻ đôi khi bỏ header Authorization)
WOO_AUTH_IN_QUERY=0

# Các trạng thái đơn cần theo dõi, cách nhau bằng dấu phẩy
WOO_STATUSES=processing
# Meta key chứa mã SPX (nếu dùng plugin hoặc trường tuỳ chỉnh). Để trống thì dùng mặc định
# và tự quét cả ghi chú đơn để tìm chuỗi dạng SPXVN...
#WOO_TRACKING_META_KEYS=_spx_tracking

# 1 = tự chuyển đơn sang "Đã hoàn thành" khi SPX báo giao thành công
COMPLETE_ON_DELIVERED=0
# 1 = ghi chú nội bộ (khách không thấy, không gửi email cho khách)
PRIVATE_NOTES=0
